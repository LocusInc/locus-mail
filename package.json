{
  "name": "locus-mail",
  "version": "0.1.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "locus-mail": "./bin/locus-mail.cjs"
  },
  "files": [
    "dist",
    "bin",
    "app",
    "public",
    "next.config.ts",
    "tsconfig.json"
  ],
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.package.json",
    "build:preview": "next build",
    "prepack": "npm run build",
    "preview": "node bin/locus-mail.cjs",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test tests/*.test.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "fast-glob": "^3.3.3",
    "next": "16.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tsx": "^4.23.15"
  }
}
