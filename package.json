{
  "name": "locus-mail",
  "version": "0.1.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "locus-mail": "./bin/locus-mail.cjs"
  },
  "files": [
    "dist",
    "bin/locus-mail.cjs",
    "bin/template-registry.cjs",
    "app",
    "public",
    "next.config.ts",
    "postcss.config.mjs",
    "tsconfig.json"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.package.json",
    "build:preview": "next build --webpack",
    "prepack": "npm run build",
    "preview": "node bin/locus-mail.cjs",
    "start": "next start",
    "lint": "eslint",
    "pretest": "npm run build",
    "test": "node --import tsx --test tests/*.test.tsx",
    "test:consumer": "node bin/check-consumer.cjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@locus-ui/components": "^0.1.19",
    "@tailwindcss/postcss": "^4.3.5",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "fast-glob": "^3.3.3",
    "next": "16.4.5",
    "prettier": "^3.9.10",
    "prismjs": "^1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-simple-code-editor": "^0.14.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/prismjs": "^1.26.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tsx": "^4.23.15"
  }
}
